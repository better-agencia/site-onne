---
// Contato flutuante: WhatsApp com captura de nome/telefone antes de abrir o wa.me.
const WA_NUMBER = '5516997554669';
const WA_TEXT = 'Olá, vim do site';
const WA_URL = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(WA_TEXT)}`;
---
<div class="fab-stack">
  <button class="fab fab--wa" type="button" data-wa-open aria-controls="wa-panel" aria-expanded="false" aria-label="Falar no WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11 11 0 0 0 3.3 17.6L2 22l4.5-1.3A11 11 0 1 0 20.5 3.5z"/><path d="M8.5 8.2c.3-.6.6-.6 1-.6h.7c.2 0 .5 0 .7.6l.8 1.9c.1.3 0 .5-.1.7l-.6.6c.5 1 1.2 1.7 2.2 2.2l.6-.6c.2-.2.4-.2.7-.1l1.9.8c.6.2.6.5.6.7v.7c0 .4 0 .7-.6 1-.6.3-1.4.5-2.4.5-2.6 0-5-2-6.2-4.2-.5-.9-.7-1.7-.7-2.5 0-.9.2-1.6.5-2.1z"/></svg>
    <span class="fab-label">WhatsApp</span>
  </button>

  <div class="wa-panel" id="wa-panel" data-wa-panel hidden>
    <div class="wa-panel__head">
      <div>
        <span class="wa-panel__kicker">WhatsApp ONNE</span>
        <h2>Vamos conversar?</h2>
      </div>
      <button class="wa-panel__close" type="button" data-wa-close aria-label="Fechar">×</button>
    </div>
    <p class="wa-panel__intro">Deixe seu nome e telefone para abrirmos a conversa com o seu contexto. Depois é só apertar enviar.</p>
    <form class="wa-form" data-wa-form novalidate>
      <div class="field" data-field="nome">
        <label for="wa-nome">Nome</label>
        <input id="wa-nome" name="nome" type="text" autocomplete="name" required aria-describedby="wa-erro-nome">
        <span class="error" id="wa-erro-nome">Informe seu nome.</span>
      </div>
      <div class="field" data-field="telefone">
        <label for="wa-telefone">Telefone / WhatsApp</label>
        <input id="wa-telefone" name="telefone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="(16) 99999-9999" aria-describedby="wa-erro-telefone">
        <span class="error" id="wa-erro-telefone">Informe um telefone com DDD.</span>
      </div>
      <div class="wa-form__consent">
        <input id="wa-consentimento" name="consentimento" type="checkbox" required aria-describedby="wa-erro-consentimento">
        <label for="wa-consentimento">Autorizo a ONNE a usar esses dados para iniciar o atendimento, conforme a <a href="/politica-de-privacidade/">Política de Privacidade</a>.</label>
      </div>
      <span class="error" id="wa-erro-consentimento" style="display:none">É necessário autorizar para continuar.</span>
      <button class="btn primary wa-form__submit" type="submit">Enviar e abrir o WhatsApp</button>
      <p class="wa-form__note">Seus dados ficam salvos neste navegador e serão sincronizados com o nosso atendimento em breve.</p>
      <div class="form-status wa-form__status" role="status" aria-live="polite"></div>
    </form>
  </div>
</div>

<script is:inline define:vars={{ WA_URL, WA_TEXT }}>
(function () {
  var openBtn = document.querySelector('[data-wa-open]');
  var panel = document.querySelector('[data-wa-panel]');
  var closeBtn = document.querySelector('[data-wa-close]');
  var form = document.querySelector('[data-wa-form]');
  if (!openBtn || !panel || !form) return;

  var status = form.querySelector('.wa-form__status');
  var submit = form.querySelector('.wa-form__submit');

  function setStatus(msg, kind) {
    if (!status) return;
    status.textContent = msg || '';
    status.className = 'form-status wa-form__status' + (msg ? ' show ' + (kind || '') : '');
  }
  function showPanel(show) {
    panel.hidden = !show;
    openBtn.setAttribute('aria-expanded', String(show));
    if (show) {
      setStatus('', '');
      try { form.querySelector('#wa-nome').focus(); } catch (e) {}
    }
  }
  openBtn.addEventListener('click', function () { showPanel(panel.hidden); });
  closeBtn.addEventListener('click', function () { showPanel(false); openBtn.focus(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.hidden) { showPanel(false); openBtn.focus(); }
  });
  document.addEventListener('click', function (e) {
    if (panel.hidden) return;
    if (!panel.contains(e.target) && !openBtn.contains(e.target)) showPanel(false);
  });

  function mark(field, invalid) {
    field.setAttribute('data-invalid', invalid ? 'true' : 'false');
  }
  function validate() {
    var nome = form.querySelector('#wa-nome');
    var tel = form.querySelector('#wa-telefone');
    var consent = form.querySelector('#wa-consentimento');
    var digits = (tel.value || '').replace(/\D/g, '');
    var ok = true;
    mark(nome.closest('.field'), nome.value.trim().length < 2);
    if (nome.value.trim().length < 2) ok = false;
    mark(tel.closest('.field'), digits.length < 10 || digits.length > 13);
    if (digits.length < 10 || digits.length > 13) ok = false;
    var consentErr = document.getElementById('wa-erro-consentimento');
    if (!consent.checked) {
      ok = false;
      if (consentErr) consentErr.style.display = 'block';
      consent.setAttribute('aria-invalid', 'true');
    } else {
      if (consentErr) consentErr.style.display = 'none';
      consent.removeAttribute('aria-invalid');
    }
    return ok;
  }
  form.querySelectorAll('input').forEach(function (el) {
    el.addEventListener('input', function () {
      if (el.type === 'checkbox') return;
      mark(el.closest('.field'), false);
    });
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!validate()) { setStatus('Confira os campos destacados.', 'error'); return; }
    var nome = form.querySelector('#wa-nome').value.trim();
    var tel = form.querySelector('#wa-telefone').value.trim();
    var payload = {
      nome: nome,
      telefone: tel,
      origem: 'floating-whatsapp',
      pagina: location.pathname,
      utm: {},
      criadoEm: new Date().toISOString()
    };
    try {
      var q = new URLSearchParams(location.search);
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function (k) {
        if (q.get(k)) payload.utm[k] = q.get(k);
      });
    } catch (err) {}
    // Guarda localmente para futura sincronização com o CRM da Better.
    try {
      var key = 'onne_wa_leads';
      var list = JSON.parse(localStorage.getItem(key) || '[]');
      list.push(payload);
      localStorage.setItem(key, JSON.stringify(list));
      sessionStorage.setItem('onne_wa_last', JSON.stringify(payload));
    } catch (err) {}
    setStatus('Pronto! Abrindo a conversa…', 'success');
    if (submit) submit.disabled = true;
    var url = WA_URL;
    // Abre em nova aba; alguns navegadores bloqueiam popup se houver atraso, então é imediato.
    var win = window.open(url, '_blank', 'noopener');
    if (!win) location.href = url;
    setTimeout(function () { showPanel(false); if (submit) submit.disabled = false; }, 600);
  });
})();
</script>
