    {
      "@type": "FAQPage",
      "@id": "https://onnebr.com/seminovos/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que o laudo técnico comprova?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O laudo registra histórico e horas de voo, saúde das baterias, integridade mecânica, sensores e calibrações. Cada unidade tem um documento individual assinado pelos técnicos."
          }
        },
        {
          "@type": "Question",
          "name": "As unidades têm garantia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. As condições e o prazo de garantia são informados por unidade, com cobertura de defeitos funcionais auditados e exclusões de desgaste natural e mau uso."
          }
        },
        {
          "@type": "Question",
          "name": "Consigo reservar uma unidade?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. A reserva é solicitada pelo formulário com o ID da unidade. O especialista envia o laudo completo em PDF e confirma as condições comerciais antes do envio."
          }
        },
        {
          "@type": "Question",
          "name": "Vocês aceitam o meu drone usado na troca?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A avaliação de troca é feita caso a caso, mediante análise técnica do equipamento. Fale com o especialista de seminovos para avaliar a possibilidade."
          }
        }
      ]
    },
