      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual a vantagem da câmera térmica na vigilância?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O sensor térmico identifica assinaturas de calor de pessoas, veículos e focos de incêndio em condições de escuridão, fumaça ou vegetação densa, permitindo ação preventiva antes do contato físico."
          }
        },
        {
          "@type": "Question",
          "name": "Posso comprar o drone e operar com minha equipe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. A modalidade CAPEX inclui a plataforma, os sensores, o treinamento da equipe e o suporte da ONNE. Também é possível contratar a operação como serviço."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona a operação por contrato?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A ONNE assume equipamento, pilotos certificados, seguro, manutenção e relatórios, com custo mensal previsível. O escopo é definido após estudo do perímetro e da rotina de segurança."
          }
        },
        {
          "@type": "Question",
          "name": "As imagens podem ser usadas como prova?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A cadeia de custódia é tratada com procedimentos de registro e armazenamento. A validade jurídica depende do caso concreto e deve ser alinhada com o jurídico e as autoridades competentes."
          }
        }
      ]
