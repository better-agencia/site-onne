    {
      "@type": "FAQPage",
      "@id": "https://onnebr.com/criadores-e-audiovisual/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Preciso de autorização para voar com drone consumer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Drones acima de 250 g e operações profissionais exigem cadastro e observância das regras da ANAC e do DECEA. A ONNE orienta o caminho e oferece treinamento; confirme sempre os requisitos vigentes."
          }
        },
        {
          "@type": "Question",
          "name": "Qual drone escolher para começar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para começar com simplicidade, DJI Neo 2, Flip e Mini 5 Pro são as portas de entrada. O Mini 5 Pro abaixo de 249 g facilita viagens; Flip e Neo priorizam praticidade."
          }
        },
        {
          "@type": "Question",
          "name": "Vale a pena investir em um drone com câmera Hasselblad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se o resultado final exige faixa dinâmica, detalhe e flexibilidade de pós-produção, a linha Mavic Pro faz sentido. Para redes sociais e viagens, modelos menores entregam o necessário com mais leveza."
          }
        },
        {
          "@type": "Question",
          "name": "A ONNE vende acessórios e dá aula de primeiro voo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Temos acessórios originais, kits prontos e treinamentos práticos. O Kit Drone Iniciante inclui aula de primeiro voo na ONNE."
          }
        }
      ]
    },
