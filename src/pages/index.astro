---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Página home não encontrada.');
const { Content } = await render(entry);
const schemaModules = import.meta.glob<Record<string, unknown>>('../data/schemas/*.json', { eager: true, import: 'default' });
const schema = schemaModules[`../data/schemas/${entry.id}.json`];
const { title, description, path, menuName, breadcrumbLabel, bodyClass, vertical, ogImage, ogType, noindex, breadcrumbs, intro } = entry.data;
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  menuName={menuName}
  breadcrumbLabel={breadcrumbLabel}
  bodyClass={bodyClass}
  vertical={vertical}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
  breadcrumbs={breadcrumbs}
  intro={intro}
  schema={schema}
>
  <Content />
</BaseLayout>
