---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((entry) => entry.data.path !== '/' && entry.data.path !== '/404/')
    .map((entry) => ({
      params: { slug: entry.data.path.replace(/^\/|\/$/g, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const schemaModules = import.meta.glob<Record<string, unknown>>('../data/schemas/*.json', { eager: true, import: 'default' });
const schema = schemaModules[`../data/schemas/${entry.id}.json`];
const { title, description, path, menuName, breadcrumbLabel, bodyClass, vertical, ogImage, ogType, noindex, breadcrumbs, intro } = entry.data;
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  menuName={menuName}
  breadcrumbLabel={breadcrumbLabel}
  bodyClass={bodyClass}
  vertical={vertical}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
  breadcrumbs={breadcrumbs}
  intro={intro}
  schema={schema}
>
  <Content />
</BaseLayout>
